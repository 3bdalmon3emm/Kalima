  booklet_instance_id    Int
  teacher_id             Int
  token_hash             String                       @unique @db.VarChar(128)
  share_token_ciphertext String?                      @db.Text
  passcode_hash          String?                      @db.VarChar(128)
  passcode_ciphertext    String?                      @db.Text
  passcode_hint          String?                      @db.VarChar(20)
  max_uses               Int?
  used_count             Int                          @default(0)
  expires_at             DateTime?                    @db.Timestamp(6)
  status                 e_booklet_invite_status_enum @default(active)
  created_at             DateTime?                    @default(now()) @db.Timestamp(6)

  booklet_instance       e_booklet_instances                @relation(fields: [booklet_instance_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  teacher                users                              @relation("EBookletInviteTeacher", fields: [teacher_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
