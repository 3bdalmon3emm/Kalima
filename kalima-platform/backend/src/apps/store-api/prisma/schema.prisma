  redemptions            e_booklet_invite_redemptions[]
  student_purchase_links e_booklet_student_purchase_links[]

  @@index([booklet_instance_id, status], map: "ix_e_booklet_invites_instance_status")
  @@index([teacher_id, status], map: "ix_e_booklet_invites_teacher_status")
}

model e_booklet_devices {
  id                  Int       @id @default(autoincrement())
