  terms_accepted_at   DateTime?                    @db.Timestamp(6)
  terms_version       String?                      @db.VarChar(50)
  status              e_booklet_access_status_enum @default(active)
  granted_at          DateTime?                    @default(now()) @db.Timestamp(6)
  revoked_at          DateTime?                    @db.Timestamp(6)

  booklet_instance        e_booklet_instances                 @relation(fields: [booklet_instance_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user                    users                               @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  source_invite           e_booklet_invites?                  @relation(fields: [source_invite_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  student_purchase_links  e_booklet_student_purchase_links[]
  access_code_redemptions e_booklet_access_code_redemptions[]

  @@unique([booklet_instance_id, user_id, role])
  @@index([user_id, role, status], map: "ix_e_booklet_access_user_role_status")
  @@index([booklet_instance_id, role, status], map: "ix_e_booklet_access_instance_role_status")
}

model e_booklet_invites {
